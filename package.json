{
  "name": "telah-notification-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "tsc": "rimraf -rf dist && tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "start": "nodemon --watch src -e ts --delay 2.5 --exec 'api-doc --input ./src/conf/router.ts --out ./openapi.json && ts-node -r dotenv/config src/index.ts'",
    "typeorm": "DOTENV_CONFIG_PATH='migration.env' ts-node -r dotenv/config ./node_modules/typeorm/cli -f ./src/conf/ormconfig.ts",
    "install:auth-api-sdk": "ts-node --skip-project -r dotenv/config scripts/auth-api-sdk.ts",
    "install:rbac-api-sdk": "ts-node --skip-project -r dotenv/config scripts/rbac-api-sdk.ts",
    "install:account-api-sdk": "ts-node --skip-project -r dotenv/config scripts/account-api-sdk.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telahng/telah-notification-api.git"
  },
  "keywords": [],
  "author": "Olaleye Afolabi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/telahng/telah-notification-api/issues"
  },
  "homepage": "https://github.com/telahng/telah-notification-api#readme",
  "devDependencies": {
    "@matchmakerjs/api-doc-cli": "^0.0.1",
    "@matchmakerjs/rest-assured": "^0.0.1",
    "@types/faker": "^5.5.9",
    "@types/jest": "^27.4.0",
    "@types/kafkajs": "^1.9.0",
    "@types/node": "^18.11.18",
    "@types/nodemailer": "^6.4.15",
    "@types/shelljs": "^0.8.11",
    "@types/validator": "^13.7.1",
    "@typescript-eslint/eslint-plugin": "^5.10.1",
    "@typescript-eslint/parser": "^5.10.1",
    "dotenv": "^14.3.2",
    "eslint": "^8.8.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "faker": "^5.5.3",
    "jest": "^27.4.7",
    "nodemailer": "^6.9.14",
    "nodemon": "^2.0.15",
    "prettier": "^2.5.1",
    "rimraf": "^3.0.2",
    "shelljs": "^0.8.5",
    "sqlite3": "^5.0.2",
    "ts-jest": "^27.1.3",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.5"
  },
  "dependencies": {
    "@matchmakerjs/di": "^0.0.1",
    "@matchmakerjs/jwt-validator": "^0.0.1",
    "@matchmakerjs/matchmaker": "^0.0.1",
    "@matchmakerjs/matchmaker-cron": "^0.0.1",
    "@matchmakerjs/matchmaker-kafkajs": "^0.0.1",
    "@matchmakerjs/matchmaker-redis": "^0.0.1",
    "@matchmakerjs/matchmaker-request-listener": "^0.0.1",
    "@matchmakerjs/matchmaker-security": "^0.0.1",
    "@matchmakerjs/matchmaker-typeorm": "^0.0.1",
    "@matchmakerjs/rbac-client": "^1.0.0",
    "@matchmakerjs/typeorm-audit": "^0.0.1",
    "@redis/client": "^1.5.6",
    "axios": "^0.25.0",
    "bignumber.js": "^9.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.5",
    "firebase-admin": "^11.7.0",
    "form-data": "^4.0.0",
    "handlebars": "^4.7.7",
    "kafkajs": "^1.15.0",
    "pg": "^8.7.1",
    "prettier-eslint": "^16.4.2",
    "reflect-metadata": "^0.1.13",
    "twilio": "^4.20.1",
    "typeorm": "^0.2.45",
    "typeorm-naming-strategies": "^2.0.0"
  }
